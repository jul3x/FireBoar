# Disable caching for files the browser must always re-check on deploy
<FilesMatch "^(index\.html|flutter_service_worker\.js|flutter_bootstrap\.js|manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# Long-lived cache for content-hashed assets (JS/WASM bundles, canvaskit, pyodide)
<FilesMatch "\.(js|wasm|mjs)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Medium cache for images, audio, fonts
<FilesMatch "\.(png|jpg|jpeg|gif|ico|svg|mp3|woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=86400"
</FilesMatch>
